{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dashboard": {
    "JwtSecret": "",
    "JwtExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "Dashboard": "Data Source=dashboard.db"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 8883,
    "Username": "",
    "Password": "",
    "UseTls": true,
    "CaFile": "Certs/ca.crt",
    "ClientCertFile": "Certs/device.crt",
    "ClientKeyFile": "Certs/device.key"
  },
  "Unity": {
    "GrpcEndpoint": "https://localhost:9090",
    "GrpcClientCertFile": "Certs/device.crt",
    "GrpcClientKeyFile": "Certs/device.key"
  },
  "IoTGame": {
    "BufferWindowMs": 0,
    "MaxEventsPerSecond": 60,
    "AdminApiKey": ""
  },
  "DeviceRegistry": {
    "devices": {
      "esp32-01": {
        "defaultPlayerId": "player-1",
        "inputs": {
          "joystick-x":  { "type": "knob",      "inputName": "move-x",      "inputRole": "player",      "emits": "float 0.0–1.0 (normalized by the firmware)" },
          "joystick-y":  { "type": "knob",      "inputName": "move-y",      "inputRole": "player",      "emits": "float 0.0–1.0 (normalized by the firmware)" },
          "stick-click": { "type": "button",    "inputName": "fire",        "inputRole": "player",      "emits": "1.0 on pressed, 0.0 on released" },
          "btn-1":       { "type": "button",    "inputName": "admin-start", "inputRole": "stage",       "emits": "1.0 on pressed — routes to GameSessionManager.StartRound()" },
          "btn-2":       { "type": "button",    "inputName": "admin-end",   "inputRole": "stage",       "emits": "1.0 on pressed — routes to GameSessionManager.EndRound()" },
          "dht11":       { "type": "dht11",     "inputRole": "environment", "envKey": "unused",     "emits": "", "auxiliaryKeys": { "humidity": "spawn_rate" }},
          "distance":    { "type": "ultrasonic","inputRole": "environment", "envKey": "ultrasonic_zone", "emits": "zone int 1–4 (hysteresis-filtered); only sent on zone change" }
        }
      },
      "esp32-02": {
        "defaultPlayerId": "player-2",
        "inputs": {
          "knob":  { "type": "knob",   "inputName": "move-x",      "inputRole": "player", "emits": "float 0.0–1.0 (normalized from raw ADC 0–4095)" },
          "btn-1": { "type": "button", "inputName": "move-y-up",   "inputRole": "player", "emits": "1.0 on pressed, 0.0 on released" },
          "btn-2": { "type": "button", "inputName": "move-y-down", "inputRole": "player", "emits": "1.0 on pressed, 0.0 on released" },
          "btn-3": { "type": "button", "inputName": "fire",        "inputRole": "player", "emits": "1.0 on pressed, 0.0 on released" }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:5000"
      }
    }
  }
}