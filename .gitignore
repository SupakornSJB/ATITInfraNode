# .NET build output
bin/
obj/
/packages/

# Visual Studio / Rider
.idea/
*.user
*.suo
*.userprefs
riderModule.iml
/_ReSharper.Caches/

# .NET user secrets (stored outside the repo in %APPDATA%, but guard against accidental copies)
secrets.json

# Environment files
.env
.env.*

# Phase 6: SQLite dashboard database
dashboard.db
dashboard.db-shm
dashboard.db-wal

# Optional production build of the admin dashboard (see ATITFinalProject/docs/setup.md)
GameServer/wwwroot/dashboard/

# OS
.DS_Store
Thumbs.db

# Private keys / CSRs — never commit. ca.crt and device.crt are public and fine.
*.key
*.csr
*.srl
*.pfx
*.p12

# Per-deployment certs — see ATITFinalProject/docs/setup.md. None are committed;
# .gitkeep only keeps the folder so the setup copy step works on a fresh clone.
GameServer/Certs/*
!GameServer/Certs/.gitkeep
