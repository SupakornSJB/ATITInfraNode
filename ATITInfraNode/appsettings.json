      "esp32-02": {
        "defaultPlayerId": "player-3",
        "inputs": {
          "flap": { "type": "button", "inputName": "flap", "inputRole": "player" },
          "dht11": { "type": "dht11", "inputRole": "environment", "inputName": "", "envKey": "gravity", "auxiliaryKeys": { "humidity": "spawn_rate" } },
          "distance": { "type": "ultrasonic", "inputRole": "environment", "inputName": "", "envKey": "ultrasonic_zone" }
        }
      }
