{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "192.168.1.172",
    "Port": 1883,
    "Username": "",
    "Password": ""
  },
  "Unity": {
    "GrpcEndpoint": "http://localhost:9090"
  },
  "IoTGame": {
    "BufferWindowMs": 0,
    "MaxEventsPerSecond": 60
  },
  "DeviceRegistry": {
    "players": {
      "player-1": [ "esp32-01" ],
      "player-2": [ "esp32-02" ]
//    ,
//      "player-3": [ "esp32-bird-1" ],
//      "player-4": [ "esp32-bird-2" ]
    },
    "devices": {
      "esp32-01": {
        "defaultPlayerId": "player-1",
        "inputs": {
          "joystick-x":  { "type": "knob",   "inputName": "move-x",  "inputRole": "player" },
          "joystick-y":  { "type": "knob",   "inputName": "move-y",  "inputRole": "player" },
          "stick-click":        { "type": "button", "inputName": "fire",    "inputRole": "player" }
        }
      },
//      "esp32-ship-2": {
