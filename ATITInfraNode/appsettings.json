{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "192.168.1.172",
    "Port": 1883,
    "Username": "",
    "Password": ""
  },
  "Unity": {
    "GrpcEndpoint": "http://localhost:9090"
  },
  "IoTGame": {
    "BufferWindowMs": 0,
    "MaxEventsPerSecond": 60
  },
  "DeviceRegistry": {
    "players": {
      "player-1": [ "esp32-01" ],
      "player-2": [ "esp32-01", "esp32-02" ]
    },
    "devices": {
      "esp32-01": {
        "defaultPlayerId": "player-1",
        "inputs": {
          "btn1": { "type": "button", "inputName": "jump" },
          "btn2": { "type": "button", "inputName": "jump", "playerId": "player-2" },
          "dht11": { "type": "dht11",  "inputName": "temperature", "minRaw": 0, "maxRaw": 4095 }
        }
      },
      "esp32-02": {
        "defaultPlayerId": "player-2",
        "inputs": {
          "btn1": { "type": "button", "inputName": "jump" },
          "btn2": { "type": "button", "inputName": "fire" }
        }
      }
    }
  }
}